# ==============================================================================
# CINEFACE AI STUDIO — ENVIRONMENT CONFIGURATION
# ==============================================================================

# GEMINI_API_KEY: Powers AI spoken-script generation, refinement & viral video analysis
# Obtain from Google AI Studio / Google Cloud Console.
GEMINI_API_KEY=""

# ACTIVE AI VIDEO GENERATION ENGINE:
# - "mock"   : Development Demo Sandbox (Default - runs offline without external API keys)
# - "heygen" : Production Talking-Avatar Generator (Requires HEYGEN_API_KEY)
# - "runway" : Generative B-Roll / Cinematic Diffusion (Requires RUNWAY_API_KEY - not talking avatar)
# - "veo"    : Google Veo Video Engine (Uses GEMINI_API_KEY - generative video, not talking avatar)
AI_VIDEO_PROVIDER="mock"

# PRODUCTION TALKING-AVATAR ENGINE (HeyGen):
# Used to synthesize realistic lip-synced talking avatars from uploaded authorized photos.
# Obtain an API key from https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=""

# OPTIONAL GENERATIVE VIDEO PROVIDERS (Ambient B-Roll, not talking avatars):
RUNWAY_API_KEY=""

# PORT (Default 3000)
PORT=3000
